# Copy to .env and replace every value before running `docker compose up`.
# .env is git-ignored. Never commit real credentials.

# SQL Server system administrator password (8+ characters with upper case, lower case, digit and symbol).
MSSQL_SA_PASSWORD=ChangeMe_Local_Sql_1

# HMAC key for signing access tokens, at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-random-value-of-at-least-32-characters

# Password given to every seeded demo account (at least 12 characters).
SEED_DEFAULT_PASSWORD=ChangeMe-Demo-Password

# Port the web UI is published on.
WEB_PORT=8080

# Optional Azure Service Bus transport. Leave unset to use the in-process outbox dispatcher.
# With the local emulator (docker compose --profile servicebus up):
# MESSAGING_TRANSPORT=AzureServiceBus
# SERVICEBUS_CONNECTION_STRING=Endpoint=sb://servicebus;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
