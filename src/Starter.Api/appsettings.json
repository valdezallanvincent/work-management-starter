{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "starter-api",
    "Audience": "starter-client",
    "SigningKey": ""
  },
  "Authentication": {
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00"
  },
  "Caching": {
    "Provider": "Memory",
    "DefaultExpiration": "00:05:00",
    "LookupExpiration": "00:10:00",
    "KeyPrefix": "starter:"
  },
  "Messaging": {
    "Enabled": true,
    "Transport": "InProcess",
    "PollingInterval": "00:00:02",
    "BatchSize": 20,
    "MaxAttempts": 5,
    "RetryBaseDelay": "00:00:05",
    "ServiceBus": {
      "QueueName": "work-item-events",
      "MaxConcurrentCalls": 4
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDevelopmentData": false
  },
  "RateLimiting": {
    "AuthenticationPermitsPerMinute": 10,
    "ApiPermitsPerMinute": 300
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  }
}
